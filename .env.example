# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 Git에 올라가지 않습니다)

# GitHub → Settings → Developer settings → Personal access tokens (classic)
#   https://github.com/settings/tokens/new?scopes=repo&description=practice-roulette
#   Scope: repo / Expiration: 7 days 권장
GITHUB_TOKEN=
GITHUB_OWNER=mechpower94

# Vercel → Account Settings → Tokens  https://vercel.com/account/settings/tokens
#   Scope: 개인 계정(Hobby) / Expiration: 1 day 또는 7 days 권장
VERCEL_TOKEN=

# Supabase → Account → Access Tokens  https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# 선택 항목
SERVICE_TTL_MINUTES=60
SUPABASE_REGION=ap-northeast-2
